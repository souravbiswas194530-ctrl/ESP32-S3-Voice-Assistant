// WiFi কানেকশন - SD card এর তালিকা থেকে স্বয়ংক্রিয়ভাবে (বাটন লাগবে না)
// ============================================================
// qa_database.json এর ভেতরে "wifi" key তে রাখুন:
// { "wifi": [
//     {"ssid": "Sourav", "password": "45sourav30"},
//     {"ssid": "বাসার_WiFi", "password": "পাসওয়ার্ড"}
//   ], "contacts": [...], "questions": [...] }
void setupWiFi() {
  showMessage("WiFi খোঁজা হচ্ছে...");
  Serial.println("SD card থেকে WiFi তালিকা পড়া হচ্ছে...");

  bool listLoaded = loadWiFiListFromSD();

  if (listLoaded) {
    int attempts = 0;
    while (wifiMulti.run() != WL_CONNECTED && attempts < 30) {
      delay(500);
      Serial.print(".");
      attempts++;
    }
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nWiFi কানেক্টেড: " + WiFi.SSID());
    Serial.println("IP: " + WiFi.localIP().toString());
    showMessage("সংযুক্ত: " + WiFi.SSID());
    configTime(6 * 3600, 0, "pool.ntp.org", "time.nist.gov"); // GMT+6
    return;
  }

  // কোনো পরিচিত WiFi পাওয়া যায়নি -> সেটআপ পোর্টাল (শুধু প্রথমবার/নতুন জায়গায়)
  Serial.println("\nকোনো পরিচিত WiFi পাওয়া যায়নি, সেটআপ মোড চালু হচ্ছে...");
  showMessage("নতুন WiFi সেটআপ...");

  wifiManager.setConfigPortalTimeout(180);
  bool connected = wifiManager.autoConnect("VoiceAssistant-Setup");

  if (connected) {
    Serial.println("WiFi কানেক্টেড: " + WiFi.SSID());
    showMessage("সংযুক্ত: " + WiFi.SSID());
    configTime(6 * 3600, 0, "pool.ntp.org", "time.nist.gov");
  } else {
    Serial.println("WiFi সেটআপ ব্যর্থ! রিস্টার্ট হচ্ছে...");
    showMessage("WiFi সেটআপ ব্যর্থ!");
    delay(3000);
    ESP.restart();
  }
}

// qa_database.json এর "wifi" key পড়ে WiFiMulti তে যোগ করা
// ফরম্যাট: {"wifi":[{"ssid": "Sourav", "password": "45sourav30"}, ...], ...}
bool loadWiFiListFromSD() {
  File testFile = SD_MMC.open("/qa_database.json", FILE_READ);
  if (!testFile) {
    Serial.println("qa_database.json পাওয়া যায়নি");
    return false;
  }
  testFile.close();

  File file = SD_MMC.open("/qa_database.json");
  if (!file) return false;

  DynamicJsonDocument doc(20480);
  DeserializationError error = deserializeJson(doc, file);
  file.close();

  if (error) {
    Serial.println("qa_database.json পড়তে সমস্যা হয়েছে");
    return false;
  }

  JsonArray arr = doc["wifi"].as<JsonArray>();
  int count = 0;
  for (JsonObject item : arr) {
    String ssid = item["ssid"].as<String>();
    String pass = item["password"].as<String>();
    wifiMulti.addAP(ssid.c_str(), pass.c_str());
    count++;
  }

  Serial.println(String(count) + "টা WiFi তালিকায় যোগ করা হলো");
  return count > 0;
}

