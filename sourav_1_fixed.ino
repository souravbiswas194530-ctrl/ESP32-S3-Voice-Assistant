// কোনো এরর হবে না - তাই এটা যেকোনো সময় নিরাপদে ব্যবহার করা যায়।
bool handleComputerCommand(String question) {

  if (question.indexOf("ইউটিউব খোলো") >= 0 || question.indexOf("ইউটিউব খোল") >= 0) {
    Serial.println("PC_CMD:OPEN_YOUTUBE");
    speakAndShow("ইউটিউব খোলা হচ্ছে");
    return true;
  }

  if (question.indexOf("ব্রাউজার খোলো") >= 0 || question.indexOf("ব্রাউজার খোল") >= 0) {
    Serial.println("PC_CMD:OPEN_BROWSER");
    speakAndShow("ব্রাউজার খোলা হচ্ছে");
    return true;
  }

  if (question.indexOf("ভলিউম বাড়াও") >= 0 || question.indexOf("ভলিউম বাড়া") >= 0) {
    Serial.println("PC_CMD:VOLUME_UP");
    speakAndShow("ভলিউম বাড়ানো হচ্ছে");
    return true;
  }

  if (question.indexOf("ভলিউম কমাও") >= 0 || question.indexOf("ভলিউম কমা") >= 0) {
    Serial.println("PC_CMD:VOLUME_DOWN");
    speakAndShow("ভলিউম কমানো হচ্ছে");
    return true;
  }

  if (question.indexOf("গান থামাও") >= 0 || question.indexOf("মিউজিক থামাও") >= 0 ||
      question.indexOf("প্লে করো") >= 0 || question.indexOf("পজ করো") >= 0) {
    Serial.println("PC_CMD:PLAY_PAUSE");
    speakAndShow("প্লে-পজ করা হলো");
    return true;
  }

  if (question.indexOf("স্ক্রিনশট") >= 0) {
    Serial.println("PC_CMD:SCREENSHOT");
    speakAndShow("স্ক্রিনশট নেওয়া হচ্ছে");
    return true;
  }

  if (question.indexOf("কম্পিউটার লক করো") >= 0 || question.indexOf("পিসি লক করো") >= 0) {
    Serial.println("PC_CMD:LOCK_PC");
    speakAndShow("কম্পিউটার লক করা হচ্ছে");
    return true;
  }

  return false;
}

bool handleRememberCommand(String question) {
  int rememberIdx = question.indexOf("মনে রাখো");
  if (rememberIdx < 0) return false;

  // "মনে রাখো" এর পরের অংশ নিন
  String content = question.substring(rememberIdx + String("মনে রাখো").length());
  content.trim();
  if (content.startsWith(",")) {
    content = content.substring(1);
    content.trim();
  }

  if (content.length() == 0) {
    speakAndShow("কি মনে রাখতে হবে বলুন");
    return true;
  }

  // "মানে" বা "হলো" দিয়ে প্রশ্ন ও উত্তর আলাদা করার চেষ্টা
  int splitIdx = content.indexOf(" মানে ");
  int splitLen = 6; // " মানে " এর length
  if (splitIdx < 0) {
    splitIdx = content.indexOf(" হলো ");
    splitLen = 5;
  }

  String newQuestion, newAnswer;

  if (splitIdx >= 0) {
    // যেমন: "ঢাকার ডাক নাম মানে সিটি অফ মসজিদ"
    String subject = content.substring(0, splitIdx);
    newAnswer = content.substring(splitIdx + splitLen);
    subject.trim();
    newAnswer.trim();
    newQuestion = subject + " মানে কি"; // পরে "X মানে কি" জিজ্ঞেস করলে মিলবে
  } else {
    // "মানে/হলো" না থাকলে, পুরো কথাটাই প্রশ্ন হিসেবে রাখা হবে,
    // এবং একই কথাটাই উত্তর হিসেবেও সেভ হবে (fallback)
    newQuestion = content;
    newAnswer = content;
  }

  saveToLocalDatabase(newQuestion, newAnswer, false); // volatile না, স্থায়ী তথ্য হিসেবে সেভ
  speakAndShow("মনে রাখলাম: " + newQuestion);
  return true;
}

bool handleCallOrSMSCommand(String question) {

  // ---------- SMS কমান্ড চেক ----------
  int msgIdx = question.indexOf("মেসেজ পাঠাও");
  if (msgIdx >= 0) {
    String namePart = question.substring(0, msgIdx);
    String messagePart = question.substring(msgIdx + String("মেসেজ পাঠাও").length());

    namePart.trim();
    messagePart.trim();

    // নামের শেষে থাকা "কাছে", "এর কাছে", "র কাছে" বাদ দেওয়া
    namePart.replace("এর কাছে", "");
    namePart.replace("র কাছে", "");
    namePart.replace("কাছে", "");
    namePart.trim();

    String number = lookupContactNumber(namePart);

    if (number == "") {
      speakAndShow(namePart + " এর নাম্বার খুঁজে পাইনি");
      return true;
    }
    if (messagePart == "") {
      speakAndShow("মেসেজে কি লিখতে হবে বুঝতে পারিনি");
      return true;
    }

    triggerSMS(number, messagePart);
    speakAndShow(namePart + " কে মেসেজ পাঠানো হচ্ছে");
    return true;
  }

  // ---------- Call কমান্ড চেক ----------
  int callIdx = -1;
  String callKeyword = "";
  const char* callPhrases[] = {"কে কল দাও", "কে কল করো", "কে ফোন দাও", "কে ফোন করো"};
  for (int i = 0; i < 4; i++) {
    int idx = question.indexOf(callPhrases[i]);
    if (idx >= 0) {
      callIdx = idx;
      callKeyword = callPhrases[i];
      break;
    }
  }

  if (callIdx >= 0) {
    String namePart = question.substring(0, callIdx);
    namePart.trim();

    String number = lookupContactNumber(namePart);
    if (number == "") {
      speakAndShow(namePart + " এর নাম্বার খুঁজে পাইনি");
      return true;
    }

    triggerPhoneCall(number);
    speakAndShow(namePart + " কে কল করা হচ্ছে");
    return true;
  }

  return false; // এটা কল/SMS কমান্ড না, স্বাভাবিক প্রশ্ন হিসেবে প্রসেস হবে
}

// qa_database.json এর "contacts" key থেকে নাম দিয়ে নাম্বার খোঁজা
// ফরম্যাট: {"contacts":[{"name":"মা","number":"017XXXXXXXX"}, ...], ...}
String lookupContactNumber(String spokenName) {
  File file = SD_MMC.open("/qa_database.json");
  if (!file) {
    Serial.println("qa_database.json পাওয়া যায়নি!");
    return "";
  }

  DynamicJsonDocument doc(20480);
  DeserializationError error = deserializeJson(doc, file);
  file.close();
  if (error) return "";

  JsonArray arr = doc["contacts"].as<JsonArray>();
  for (JsonObject item : arr) {
    String storedName = item["name"].as<String>();
    // সহজ মিল: spokenName এর মধ্যে storedName আছে কিনা (বা উল্টো)
    if (spokenName.indexOf(storedName) >= 0 || storedName.indexOf(spokenName) >= 0) {
      return item["number"].as<String>();
    }
  }
  return "";
}

// URL এ পাঠানোর জন্য বাংলা/স্পেশাল ক্যারেক্টার percent-encode করা
String urlEncode(String str) {
  String encoded = "";
  char c;
  char buf[4];
  for (int i = 0; i < str.length(); i++) {
    c = str.charAt(i);
    if (isalnum(c)) {
      encoded += c;
    } else if (c == ' ') {
      encoded += '+';
    } else {
      sprintf(buf, "%%%02X", (unsigned char)c);
      encoded += buf;
    }
  }
  return encoded;
}

// MacroDroid webhook দিয়ে SMS পাঠানো (আপনার ফোনের মাধ্যমে)
void triggerSMS(String number, String message) {
  if (WiFi.status() != WL_CONNECTED) return;

  // SMS পাঠানোর জন্য MacroDroid webhook
  String baseUrl = "https://trigger.macrodroid.com/cd997d99-77d7-4591-9fb7-b97a35d914be/triggerSMS";

  String url = baseUrl + "?sms_number=" + number + "&sms_message=" + urlEncode(message);

  HTTPClient http;
  http.begin(url);
  int httpCode = http.GET();
  Serial.println("SMS webhook কল করা হলো, কোড: " + String(httpCode));
  http.end();
}

// MacroDroid webhook দিয়ে কল করা (আপনার ফোনের মাধ্যমে)
void triggerPhoneCall(String number) {
  if (WiFi.status() != WL_CONNECTED) return;

  // *** আপনার Call webhook URL এখানে বসান ***
  String baseUrl = "https://trigger.macrodroid.com/cd997d99-77d7-4591-9fb7-b97a35d914be/call_trigger";

  String url = baseUrl + "?phone_number=" + number;

  HTTPClient http;
  http.begin(url);
  int httpCode = http.GET();
  Serial.println("Call webhook কল করা হলো, কোড: " + String(httpCode));
  http.end();
}

